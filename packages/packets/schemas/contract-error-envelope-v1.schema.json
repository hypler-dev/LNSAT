{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnsat.local/schemas/contract-error-envelope-v1.schema.json",
  "title": "LNSAT Contract Error Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "errors", "side_effects"],
  "properties": {
    "ok": {
      "const": false
    },
    "version": {
      "type": "null"
    },
    "packet": {
      "type": "null"
    },
    "policy_decision": {
      "type": "null"
    },
    "approval_request": {
      "type": "null"
    },
    "approval_decision": {
      "type": "null"
    },
    "audit_event": {
      "type": "null"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "side_effects": {
      "type": "array",
      "maxItems": 0
    }
  },
  "oneOf": [
    {
      "required": ["version"]
    },
    {
      "required": ["packet"]
    },
    {
      "required": ["policy_decision"]
    },
    {
      "required": ["approval_request"]
    },
    {
      "required": ["approval_decision"]
    },
    {
      "required": ["audit_event"]
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message", "severity"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
          "maxLength": 512
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "severity": {
          "const": "error"
        }
      }
    }
  }
}
