{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnsat.local/schemas/gateway-identity-password-rotation-request-v1.schema.json",
  "title": "LNSAT Gateway Identity Password Rotation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["current_password", "new_password"],
  "properties": {
    "current_password": {
      "type": "string",
      "minLength": 15,
      "maxLength": 128
    },
    "new_password": {
      "type": "string",
      "minLength": 15,
      "maxLength": 128
    }
  }
}
