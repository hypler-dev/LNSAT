{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnsat.local/schemas/gateway-identity-password-rotation-response-v1.schema.json",
  "title": "LNSAT Gateway Identity Password Rotation Response v1",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "ok",
        "status",
        "scope",
        "identity_ref",
        "credential_version",
        "rotated_at",
        "revoked_session_count",
        "transport",
        "replay_semantics",
        "side_effects",
        "credential_state_changed",
        "session_state_changed",
        "reauthentication_required",
        "execution_authority",
        "mutation_authority"
      ],
      "properties": {
        "contract": {
          "const": "lnsat.gateway.identity_password_rotation.v1_0"
        },
        "contract_version": {
          "const": "lnsat.contracts.v1_0"
        },
        "ok": {
          "const": true
        },
        "status": {
          "const": "password_rotated"
        },
        "scope": {
          "const": "authenticated_identity"
        },
        "identity_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "credential_version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "rotated_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 32
        },
        "revoked_session_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "transport": {
          "$ref": "#/$defs/transport"
        },
        "replay_semantics": {
          "const": "one_time_active_session_family"
        },
        "side_effects": {
          "type": "array",
          "prefixItems": [
            {
              "const": "authentication_limiter_advanced"
            },
            {
              "const": "session_activity_evidence_may_append"
            },
            {
              "const": "password_credential_evidence_appended"
            },
            {
              "const": "identity_security_event_appended"
            },
            {
              "const": "session_family_revocations_appended"
            },
            {
              "const": "session_security_events_appended"
            },
            {
              "const": "session_cookies_cleared"
            }
          ],
          "minItems": 7,
          "maxItems": 7
        },
        "credential_state_changed": {
          "const": true
        },
        "session_state_changed": {
          "const": true
        },
        "reauthentication_required": {
          "const": true
        },
        "execution_authority": {
          "const": false
        },
        "mutation_authority": {
          "const": false
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "ok",
        "identity_ref",
        "credential_version",
        "rotated_at",
        "revoked_session_count",
        "errors",
        "side_effects",
        "credential_state_changed",
        "session_state_changed",
        "execution_authority",
        "mutation_authority"
      ],
      "properties": {
        "contract": {
          "const": "lnsat.gateway.identity_password_rotation.v1_0"
        },
        "contract_version": {
          "const": "lnsat.contracts.v1_0"
        },
        "ok": {
          "const": false
        },
        "identity_ref": {
          "type": "null"
        },
        "credential_version": {
          "type": "null"
        },
        "rotated_at": {
          "type": "null"
        },
        "revoked_session_count": {
          "type": "null"
        },
        "errors": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/error"
            }
          ],
          "minItems": 1,
          "maxItems": 1
        },
        "side_effects": {
          "type": "array",
          "prefixItems": [
            {
              "const": "authentication_limiter_may_advance"
            }
          ],
          "minItems": 1,
          "maxItems": 1
        },
        "credential_state_changed": {
          "const": false
        },
        "session_state_changed": {
          "const": false
        },
        "execution_authority": {
          "const": false
        },
        "mutation_authority": {
          "const": false
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bind_scope",
        "same_origin_required",
        "csrf_verified",
        "cors_enabled",
        "session_cookie",
        "csrf_cookie"
      ],
      "properties": {
        "bind_scope": {
          "const": "loopback"
        },
        "same_origin_required": {
          "const": true
        },
        "csrf_verified": {
          "const": true
        },
        "cors_enabled": {
          "const": false
        },
        "session_cookie": {
          "const": "cleared_host_only_http_only_samesite_strict"
        },
        "csrf_cookie": {
          "const": "cleared_host_only_samesite_strict"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message", "severity"],
      "properties": {
        "code": {
          "const": "gateway.identity_password_rotation.denied"
        },
        "path": {
          "const": "/identity/password"
        },
        "message": {
          "const": "Password rotation denied."
        },
        "severity": {
          "const": "error"
        }
      }
    }
  }
}
