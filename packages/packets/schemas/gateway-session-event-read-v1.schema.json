{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnsat.local/schemas/gateway-session-event-read-v1.schema.json",
  "title": "LNSAT Gateway Session Event Read v1",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "ok",
        "status",
        "scope",
        "session_id",
        "events",
        "event_order",
        "side_effects",
        "identity_state_changed",
        "session_authority_state_changed",
        "packet_state_changed",
        "action_state_changed",
        "signing_authority",
        "nonce_authority",
        "consumption_authority",
        "execution_authority",
        "mutation_authority"
      ],
      "properties": {
        "contract": {
          "const": "lnsat.gateway.session_event_read.v1_0"
        },
        "contract_version": {
          "const": "lnsat.contracts.v1_0"
        },
        "ok": {
          "const": true
        },
        "status": {
          "const": "evidence_read"
        },
        "scope": {
          "const": "target_session"
        },
        "session_id": {
          "$ref": "#/$defs/session_id"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "event_order": {
          "const": "event_sequence_ascending"
        },
        "side_effects": {
          "$ref": "#/$defs/activity_side_effects"
        },
        "identity_state_changed": {
          "const": false
        },
        "session_authority_state_changed": {
          "const": false
        },
        "packet_state_changed": {
          "const": false
        },
        "action_state_changed": {
          "const": false
        },
        "signing_authority": {
          "const": false
        },
        "nonce_authority": {
          "const": false
        },
        "consumption_authority": {
          "const": false
        },
        "execution_authority": {
          "const": false
        },
        "mutation_authority": {
          "const": false
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "ok",
        "session_id",
        "events",
        "errors",
        "side_effects",
        "identity_state_changed",
        "session_authority_state_changed",
        "packet_state_changed",
        "action_state_changed",
        "signing_authority",
        "nonce_authority",
        "consumption_authority",
        "execution_authority",
        "mutation_authority"
      ],
      "properties": {
        "contract": {
          "const": "lnsat.gateway.session_event_read.v1_0"
        },
        "contract_version": {
          "const": "lnsat.contracts.v1_0"
        },
        "ok": {
          "const": false
        },
        "session_id": {
          "type": "null"
        },
        "events": {
          "type": "null"
        },
        "errors": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/error"
            }
          ],
          "minItems": 1,
          "maxItems": 1
        },
        "side_effects": {
          "$ref": "#/$defs/activity_side_effects"
        },
        "identity_state_changed": {
          "const": false
        },
        "session_authority_state_changed": {
          "const": false
        },
        "packet_state_changed": {
          "const": false
        },
        "action_state_changed": {
          "const": false
        },
        "signing_authority": {
          "const": false
        },
        "nonce_authority": {
          "const": false
        },
        "consumption_authority": {
          "const": false
        },
        "execution_authority": {
          "const": false
        },
        "mutation_authority": {
          "const": false
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "session_id",
        "event_sequence",
        "event_kind",
        "actor_session_id",
        "related_session_id",
        "revocation_reason",
        "source_evidence_digest",
        "occurred_at",
        "event_evidence_digest"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "session_id": {
          "$ref": "#/$defs/session_id"
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "event_kind": {
          "enum": ["issued", "revoked", "rotated"]
        },
        "actor_session_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/session_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "related_session_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/session_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "revocation_reason": {
          "oneOf": [
            {
              "enum": [
                "sign_out",
                "owner_revoke",
                "credential_revoke",
                "recovery",
                "rotation"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source_evidence_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "occurred_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 32
        },
        "event_evidence_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "issued"
              }
            }
          },
          "then": {
            "properties": {
              "actor_session_id": {
                "type": "null"
              },
              "related_session_id": {
                "type": "null"
              },
              "revocation_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "revoked"
              }
            }
          },
          "then": {
            "properties": {
              "related_session_id": {
                "type": "null"
              },
              "revocation_reason": {
                "enum": [
                  "sign_out",
                  "owner_revoke",
                  "credential_revoke",
                  "recovery",
                  "rotation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "rotated"
              }
            }
          },
          "then": {
            "properties": {
              "actor_session_id": {
                "$ref": "#/$defs/session_id"
              },
              "related_session_id": {
                "$ref": "#/$defs/session_id"
              },
              "revocation_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": ["event_kind", "revocation_reason"],
            "properties": {
              "event_kind": {
                "const": "revoked"
              },
              "revocation_reason": {
                "const": "recovery"
              }
            }
          },
          "then": {
            "properties": {
              "actor_session_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": ["event_kind", "revocation_reason"],
            "properties": {
              "event_kind": {
                "const": "revoked"
              },
              "revocation_reason": {
                "enum": ["sign_out", "owner_revoke", "credential_revoke", "rotation"]
              }
            }
          },
          "then": {
            "properties": {
              "actor_session_id": {
                "$ref": "#/$defs/session_id"
              }
            }
          }
        }
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^ses_[0-9a-f]{32}$"
    },
    "activity_side_effects": {
      "type": "array",
      "prefixItems": [
        {
          "const": "session_activity_evidence_may_append"
        }
      ],
      "minItems": 1,
      "maxItems": 1
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message", "severity"],
      "properties": {
        "code": {
          "const": "gateway.session_event_read.denied"
        },
        "path": {
          "const": "/sessions/{session_id}/events"
        },
        "message": {
          "const": "Session event read denied."
        },
        "severity": {
          "const": "error"
        }
      }
    }
  }
}
